# Copia este archivo como .env y completa los valores. .env NUNCA se sube al repositorio.

# --- Modelo de lenguaje ---
# anthropic | simulado. Si se omite: anthropic cuando hay clave; si no, simulado (guion sin costo).
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Modelo de Claude a usar (por defecto claude-opus-5-5). Alternativa más económica: claude-haiku-5-5
LLM_MODEL=
# Esfuerzo de razonamiento: low | medium | high | xhigh | max (por defecto medium)
LLM_EFFORT=
# Timeout por llamada al modelo, en milisegundos (por defecto 90000)
LLM_TIMEOUT_MS=

# --- Topes de costo ---
# Iteraciones herramienta→modelo por turno (por defecto 25)
MAX_ITERACIONES=
# Tokens máximos por sesión (por defecto 600000)
MAX_TOKENS_SESION=
# Tokens máximos de todo el servidor mientras está encendido (por defecto 6000000)
MAX_TOKENS_GLOBAL=
# Mensajes por IP cada 10 minutos (por defecto 40)
MAX_MENSAJES_POR_IP=

# --- Acceso ---
# Si se define, el chat pide esta clave (cabecera x-access-key)
ACCESS_KEY=
PORT=3000
